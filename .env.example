APP_NAME=SendSaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

PLATFORM_SUPERADMIN_NAME="Super administrador"
PLATFORM_SUPERADMIN_EMAIL=superadmin@sendsaas.pe
PLATFORM_SUPERADMIN_PASSWORD=password

# WhatsApp comercial (login: ¿Sin cuenta? Hablemos). 9 dígitos PE o E.164 sin +
CONTACT_WHATSAPP=51976809804

# API SUNAT / DNI — solo servidor. Primero apiperu.dev; si falla, Lucode.
APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=
APISUNAT_LOOKUP_BASE_URL=https://dev.apisunat.pe/api/v1
APISUNAT_LOOKUP_TOKEN=

# Orvae PE — mismo valor que SENDSAAS_PROVISION_HMAC_SECRET en el padre
# Generar: php scripts/generate-orvae-hmac.php
ORVAE_PROVISION_HMAC_SECRET=
ORVAE_PROVISION_MAX_SKEW_SECONDS=300
ORVAE_PROVISION_IDEMPOTENCY_TTL_DAYS=30

SENDSAAS_TENANT_SCHEME=https
SENDSAAS_TENANT_DOMAIN=sendsaas.orvae.pe
SENDSAAS_TENANT_LOGIN_PATH=/login
SENDSAAS_BOOTSTRAP_TTL_HOURS=48

# Local: TENANT_ROOT_DOMAIN=sendsaas.test y hosts {slug}.sendsaas.test
# VPS: ver .env.vps.example (sendsaas.orvae.pe + *.sendsaas.orvae.pe)
TENANT_CENTRAL_DOMAINS=localhost,127.0.0.1,sendsaas.test
TENANT_ROOT_DOMAIN=sendsaas.test
TENANT_SCHEMA_PREFIX=od_
TENANT_CACHE_TTL=60

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Tablas de framework siempre en public (multi-tenant por schema)
SESSION_TABLE=public.sessions
DB_CACHE_TABLE=public.cache
DB_CACHE_LOCK_TABLE=public.cache_locks

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Conector WhatsApp (OpenWA). Sin API_URL + API_KEY no aparece el QR.
OPENWA_ENABLED=false
OPENWA_API_URL=https://wa.vetsaas.orvae.pe
OPENWA_API_KEY=
OPENWA_ADMIN_URL=https://wa-admin.vetsaas.orvae.pe
OPENWA_TIMEOUT_SECONDS=45
OPENWA_RECONNECT_POLL_SECONDS=3
OPENWA_WEBHOOK_SECRET=
# Opcional. Default: {APP_URL}/api/webhooks/openwa/{slug}
# OPENWA_WEBHOOK_BASE_URL=https://sendsaas.orvae.pe/api/webhooks/openwa
