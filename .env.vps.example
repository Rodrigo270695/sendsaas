# =============================================================================
# SendSaaS — plantilla VPS (copiar a /var/www/sendsaas/.env)
# =============================================================================
# 1) php artisan key:generate
# 2) Pegar el MISMO HMAC en Orvae: SENDSAAS_PROVISION_HMAC_SECRET
#    Generar otro: php scripts/generate-orvae-hmac.php
# 3) php artisan migrate
# 4) php artisan db:seed --class=PermissionsSeeder
# 5) php artisan db:seed --class=SuperadminSeeder
# 6) php artisan config:cache && php artisan route:cache
# =============================================================================

APP_NAME=SendSaaS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sendsaas.orvae.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

PLATFORM_SUPERADMIN_NAME="Super administrador"
PLATFORM_SUPERADMIN_EMAIL=superadmin@sendsaas.pe
PLATFORM_SUPERADMIN_PASSWORD=

CONTACT_WHATSAPP=51976809804

# API SUNAT / DNI — primero apiperu.dev; respaldo Lucode
APIPERU_BASE_URL=https://apiperu.dev/api
APIPERU_TOKEN=
APISUNAT_LOOKUP_BASE_URL=https://dev.apisunat.pe/api/v1
APISUNAT_LOOKUP_TOKEN=

# --- Orvae (pago). Mismo secret que SENDSAAS_PROVISION_HMAC_SECRET en Orvae ---
ORVAE_PROVISION_HMAC_SECRET=
ORVAE_PROVISION_MAX_SKEW_SECONDS=300
ORVAE_PROVISION_IDEMPOTENCY_TTL_DAYS=30

SENDSAAS_TENANT_SCHEME=https
SENDSAAS_TENANT_DOMAIN=sendsaas.orvae.pe
SENDSAAS_TENANT_LOGIN_PATH=/login
SENDSAAS_BOOTSTRAP_TTL_HOURS=48

# Central = panel superadmin. Tenant = {slug}.sendsaas.orvae.pe
TENANT_CENTRAL_DOMAINS=sendsaas.orvae.pe
TENANT_ROOT_DOMAIN=sendsaas.orvae.pe
TENANT_SCHEMA_PREFIX=od_
TENANT_CACHE_TTL=60

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sendsaas
DB_USERNAME=sendsaas
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie por host (igual que VetSaaS). NO uses .sendsaas.orvae.pe:
# si se comparte, abrir el subdominio con el superadmin da 403.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Tablas de framework siempre en public (multi-tenant por schema)
SESSION_TABLE=public.sessions
DB_CACHE_TABLE=public.cache
DB_CACHE_LOCK_TABLE=public.cache_locks

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notificaciones@orvae.pe"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"

# Conector WhatsApp (OpenWA). Mismo gateway que VetSaaS si Orvae lo comparte.
OPENWA_ENABLED=true
OPENWA_API_URL=https://wa.vetsaas.orvae.pe
OPENWA_API_KEY=
OPENWA_ADMIN_URL=https://wa-admin.vetsaas.orvae.pe
OPENWA_TIMEOUT_SECONDS=45
OPENWA_RECONNECT_POLL_SECONDS=3
